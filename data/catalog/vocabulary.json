  "use_cases": {
    "$comment": "The standardized use-case vocabulary. Requirement extraction maps free text onto these, and products declare which they suit. Both sides must use the same strings or matching silently scores zero.",
    "values": [
      "gaming",
      "programming",
      "college",
      "office",
      "content_creation",
      "photography",
      "video_editing",
      "travel",
      "music",
      "calls",
      "productivity",
      "daily_use",
      "professional",
      "home_entertainment"
    ]
  },
  "performance": {
    "$comment": "A RECOMMENDATION SIGNAL, NOT A BENCHMARK. These are 1-10 editorial judgements of how well a product serves a purpose, comparable only within a category. A 9 for gaming on a laptop and a 9 for gaming on a TV say 'good for gaming in its class' — they are not a claim that the two perform alike, and nothing derived from them may be presented to a customer as a measurement.",
    "scale": {
      "min": 1,
      "max": 10,
      "integer": true
    },
    "dimensions": [
      "gaming",
      "programming",
      "office",
      "content_creation",
      "photography",
      "video_editing",
      "portability",
      "battery",
      "display_quality",
      "audio_quality",
      "build_quality",
      "value"
    ]
  },
  "specifications": {
    "$comment": "Normalized spec keys. `numeric` keys are stored in product_specs.spec_value_num and are what range filters push into Postgres; `text` keys are matched with equals/contains. `unit` is the ONE unit a value may be expressed in — an importer converting 1 TB to 1024 here and 1000 there makes '1TB SSD under 10k' return different things on different days.",
    "numeric": {
      "ram_gb": {
        "unit": "GB"
      },
      "storage_gb": {
        "unit": "GB",
        "note": "Binary convention: 1 TB = 1024."
      },
      "capacity_gb": {
        "unit": "GB",
        "note": "Storage products. Same convention as storage_gb."
      },
      "vram_gb": {
        "unit": "GB"
      },
      "display_size_in": {
        "unit": "inch"
      },
      "refresh_rate_hz": {
        "unit": "Hz"
      },
      "resolution_width": {
        "unit": "px"
      },
      "resolution_height": {
        "unit": "px"
      },
      "battery_mah": {
        "unit": "mAh"
      },
      "battery_wh": {
        "unit": "Wh"
      },
      "battery_hours": {
        "unit": "hours"
      },
      "camera_mp": {
        "unit": "MP"
      },
      "charging_w": {
        "unit": "W"
      },
      "power_w": {
        "unit": "W"
      },
      "weight_kg": {
        "unit": "kg"
      },
      "speed_mhz": {
        "unit": "MHz"
      },
      "read_speed_mbps": {
        "unit": "MB/s"
      },
      "write_speed_mbps": {
        "unit": "MB/s"
      },
      "cores": {
        "unit": "count"
      },
      "threads": {
        "unit": "count"
      },
      "hdmi_version": {
        "unit": "version",
        "note": "2.1 stored as 2.1, so >= 2.1 filters work."
      },
      "audio_output_w": {
        "unit": "W"
      }
    },
