  "relationship_types": {
    "$comment": "How one product relates to another. `type` drives both the wording shown and whether price proportionality applies — an accessory dearer than its anchor is suppressed, an upsell is expected to cost more.",
    "values": [
      "cross_sell",
      "upsell",
      "alternative",
      "accessory",
      "compatible",
      "frequently_bought_together",
      "ecosystem",
      "replacement",
      "upgrade"
    ]
  },
  "compatibility_predicates": {
    "$comment": "How a compatibility claim is meant. `not_compatible_with` is an exclusion and always wins over any positive match — refusing to sell a part that will not fit matters more than making the sale.",
    "values": [
      "compatible_with",
      "requires",
      "works_with",
      "not_compatible_with",
      "recommended_for"
