# ============================================================================
# ShopiQ — environment configuration
# ============================================================================
# Copy to .env.local and fill in. .env.local is gitignored; never commit real
# values. Only NEXT_PUBLIC_* variables are ever sent to the browser.
# ============================================================================

# ---------------------------------------------------------------- Supabase --
# Safe to expose: the anon key is gated by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses every RLS policy. Never import this into a client
# component, never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -------------------------------------------------------------- Cloudflare --
# SERVER ONLY. Product image uploads are signed server-side; the browser never
# sees these credentials.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=shopiq

# Public base URL for the bucket. Either a custom domain bound to the bucket
# (https://cdn.example.com) or the r2.dev URL Cloudflare gives you.
# Leave EMPTY to serve images through ShopiQ's own /api/media proxy instead,
# which works without making the bucket public.
R2_PUBLIC_URL=

# ------------------------------------------------------------------- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ShopiQ
NEXT_PUBLIC_SUPPORT_EMAIL=shopiq@yashgarg.co.in

# Free delivery threshold and flat rate, in whole rupees. Mirrored in
# public.create_order_from_cart() — change both together.
NEXT_PUBLIC_FREE_DELIVERY_OVER=999
NEXT_PUBLIC_DELIVERY_FLAT_RATE=79

# ------------------------------------------------------------ AI (Phase 2) --
# SERVER ONLY. All of these stay out of the browser bundle.
#
# ShopiQ works with NO key set: the agent falls back to deterministic mode —
# rule-based requirement extraction and templated explanations over the same
# real catalogue data. Search, filtering, scoring and comparison are identical;
# only the wording is templated rather than generated.
#
# AI_PROVIDER: anthropic | sarvam | none. Leave unset to auto-detect from
# whichever key is present.
AI_PROVIDER=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# ---- Sarvam. SERVER ONLY. Powers both Indian-language chat and voice. ----
# One key covers chat completions, speech-to-text and text-to-speech. It is
# read only in lib/ai/provider/sarvam.ts and lib/voice/sarvam.ts, both of which
# import 'server-only' — so an accidental client import fails the build rather
# than shipping the key. Never prefix it with NEXT_PUBLIC_.
SARVAM_API_KEY=
# SARVAM_MODEL=sarvam-105b        # sarvam-m is DEPRECATED (hard 400)
# SARVAM_BASE_URL=https://api.sarvam.ai/v1

# ---- Voice (Phase 5). SERVER ONLY. ----
# Speech lives at the API ROOT, not under /v1, and authenticates with
# api-subscription-key rather than a bearer token. Both quirks are contained in
# lib/voice/sarvam.ts.
#
# Sarvam retires speech models aggressively and returns a hard 400 for a
# deprecated one. saarika:v2 went first, then bulbul:v2. These defaults are
# verified working; override them here when the next deprecation lands rather
# than editing code.
#
# Speakers are model-specific: bulbul:v3 rejects 'anushka', which was valid
# on v2.
# SARVAM_STT_MODEL=saarika:v2.5
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=ritu
# SARVAM_SPEECH_BASE_URL=https://api.sarvam.ai
#
# With no key set, the voice layer falls back to a deterministic mock so the
# pipeline stays testable. Unlike the payment mock this is harmless: the worst
# case is that voice does not work and the customer types instead, which is the
# documented fallback anyway.

# ---- Payments (Phase 4). SERVER ONLY. Razorpay TEST mode. ----
# Get these from the Razorpay dashboard in Test Mode. A test key id starts
# with rzp_test_ — a key starting rzp_live_ moves real money and must not be
# used here.
#
# RAZORPAY_KEY_ID is the publishable key: the browser needs it to open
# Razorpay Checkout, and the server hands it over in the payment response.
# RAZORPAY_KEY_SECRET and RAZORPAY_WEBHOOK_SECRET are server-only. They are
# read exclusively in lib/payments/razorpay.ts, which imports 'server-only',
# so importing them from a client component fails the build rather than
# shipping a key to the browser. Never prefix either with NEXT_PUBLIC_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# With no Razorpay keys set, the payment layer falls back to a deterministic
# mock provider so the whole checkout chain stays testable. That fallback is
# refused in production unless this is explicitly set to true — a mock quietly
# standing in for a gateway is how a store ships goods nobody paid for.
# PAYMENTS_ALLOW_MOCK=false

# ---- Email. SERVER ONLY. ----
# Transactional invoice + support mail. SMTP is preferred over Resend because
# Supabase Auth can be pointed at the same server, so the sign-in code and the
# invoice come from one sender rather than two unrelated ones.
#
# With NOTHING configured, mail is queued in email_outbox and left `queued` —
# honestly pending, never reported as sent.
#
# Note on port/TLS: 465 is implicit TLS, 587 and 25 start plaintext and upgrade
# via STARTTLS. SMTP_SECURE is derived from the port unless set explicitly.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=          # Gmail requires an App Password, not the account password
# SMTP_SECURE=            # optional; defaults to true only on port 465
# EMAIL_FROM=ShopiQ <shopiq@yashgarg.co.in>
#
# Alternative transport, used only when no SMTP host is set:
# RESEND_API_KEY=

# ---- Delivery estimate (Phase 7) ----
# ShopiQ has no carrier integration, so this is CONFIGURATION, not a
# calculation. The agent is never allowed to invent a delivery date.
# DELIVERY_ESTIMATE_DAYS=2

# ---- Geocoding (Phase 7) ----
# Reverse geocoding for "use my current location". Defaults to OpenStreetMap
# Nominatim, which needs no key. Only ever called after the customer grants
# browser location permission.
# GEOCODER_URL=https://nominatim.openstreetmap.org/reverse

