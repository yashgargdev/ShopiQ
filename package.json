{
  "name": "shopiq",
  "version": "1.0.0",
  "description": "ShopiQ — an AI-native commerce platform you shop by talking to, in English or Hindi.",
  "private": true,
  "license": "MIT",
  "author": "Yash Garg (https://github.com/YashGargDev)",
  "homepage": "https://shopiq.yashgarg.co.in",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yashgargdev/ShopiQ.git"
  },
  "bugs": {
    "url": "https://github.com/yashgargdev/ShopiQ/issues"
  },
  "keywords": [
    "ai",
    "agent",
    "agentic-commerce",
    "ecommerce",
    "voice-commerce",
    "conversational-ai",
    "nextjs",
    "supabase",
    "razorpay",
    "sarvam-ai",
    "recommendation-engine",
    "hindi"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:seed": "node -r dotenv/config scripts/seed.mjs dotenv_config_path=.env.local",
    "r2:check": "node -r dotenv/config scripts/check-r2.mjs dotenv_config_path=.env.local",
    "test:api": "node scripts/smoke-test.mjs",
    "test:auth": "node -r dotenv/config scripts/test-auth-flow.mjs dotenv_config_path=.env.local",
    "test:visual": "node scripts/visual-check.mjs",
    "test:ai-unit": "node scripts/test-ai-unit.mjs",
    "test:ai-provider": "node scripts/test-ai-provider.mjs",
    "test:ai-tools": "node -r dotenv/config scripts/test-ai-tools.mjs dotenv_config_path=.env.local",
    "test:ai-chat": "node -r dotenv/config scripts/test-ai-chat.mjs dotenv_config_path=.env.local",
    "test:ai-ui": "node scripts/test-ai-ui.mjs",
    "test:ai": "npm run test:ai-unit && npm run test:ai-provider && npm run test:ai-tools && npm run test:ai-chat && npm run test:ai-ui",
    "test:cart-unit": "node scripts/test-cart-unit.mjs",
    "test:cart-tools": "node -r dotenv/config scripts/test-cart-tools.mjs dotenv_config_path=.env.local",
    "test:cart-ui": "node scripts/test-cart-ui.mjs",
    "test:cart": "npm run test:cart-unit && npm run test:cart-tools && npm run test:cart-ui",
    "test:all": "npm run test:api && npm run test:auth && npm run test:visual && npm run test:ai && npm run test:cart && npm run test:payment && npm run test:voice-all && npm run test:analytics && npm run test:security && npm run test:agent && npm run test:catalog",
    "test:payment-unit": "node scripts/test-payment-unit.mjs",
    "test:payments": "node -r dotenv/config scripts/test-payments.mjs dotenv_config_path=.env.local",
    "test:payment-flows": "node -r dotenv/config scripts/test-payment-flows.mjs dotenv_config_path=.env.local",
    "test:payment-ui": "node -r dotenv/config scripts/test-payment-ui.mjs dotenv_config_path=.env.local",
    "test:payment": "npm run test:payment-unit && npm run test:payments && npm run test:payment-flows && npm run test:payment-ui",
    "test:voice-unit": "node scripts/test-voice-unit.mjs",
    "test:voice": "node -r dotenv/config scripts/test-voice.mjs dotenv_config_path=.env.local",
    "test:voice-ui": "node -r dotenv/config scripts/test-voice-ui.mjs dotenv_config_path=.env.local",
    "test:voice-all": "npm run test:voice-unit && npm run test:voice && npm run test:voice-ui",
    "eval": "node -r dotenv/config scripts/eval.mjs dotenv_config_path=.env.local",
    "test:security": "node -r dotenv/config scripts/test-security.mjs dotenv_config_path=.env.local",
    "test:analytics": "node -r dotenv/config scripts/test-analytics.mjs dotenv_config_path=.env.local",
    "test:agent": "node -r dotenv/config scripts/test-agent.mjs dotenv_config_path=.env.local",
    "dev:https": "next dev --experimental-https",
    "dev:mock": "cross-env PAYMENTS_PROVIDER=mock next dev",
    "dev:mock-https": "cross-env PAYMENTS_PROVIDER=mock next dev --experimental-https",
    "test:catalog": "node scripts/test-catalog.mjs",
    "catalog:build": "node scripts/build-demo-catalog.mjs",
    "catalog:validate": "node -r dotenv/config scripts/import-catalog.mjs --dry-run dotenv_config_path=.env.local",
    "catalog:import": "node -r dotenv/config scripts/import-catalog.mjs dotenv_config_path=.env.local",
    "test:catalog-data": "node -r dotenv/config scripts/test-catalog-data.mjs dotenv_config_path=.env.local"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@aws-sdk/client-s3": "^3.1117.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.95.0",
    "next": "16.3.2",
    "nodemailer": "^9.0.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "pg": "^8.13.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
